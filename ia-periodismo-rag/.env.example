# Configuración de Entorno - DilemaBot

# Django
DJANGO_SECRET_KEY=clave_secreta_para_produccion_o_desarrollo
DJANGO_DEBUG=True

# Proveedor de LLM (Opcional - Si se dejan vacíos, DilemaBot usa el motor analítico local autónomo)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Base de datos Vectorial (Opcional si se ejecuta pgvector con docker-compose.yml)
USE_PGVECTOR=False
POSTGRES_DB=periodismo_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
